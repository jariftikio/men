# Signing secret for mock IdP JWTs (auth codes + access/id/refresh tokens).
# Generate one:  openssl rand -hex 32
# Local: put the value in .env.local (same folder as package.json).
# Vercel: Project → Settings → Environment Variables → Add JWT_SECRET
#   (Production + Preview). Redeploy after saving.
# If unset, the Mock IdP uses a built-in fallback so previews still work.
JWT_SECRET=change-me-to-a-long-random-string

# Base URL of the Mock IdP API (no trailing slash)
# Local:  http://localhost:3000/api/mock-idp
# Vercel: https://YOUR_PROJECT.vercel.app/api/mock-idp
NEXT_PUBLIC_MOCK_IDP_URL=http://localhost:3000/api/mock-idp
